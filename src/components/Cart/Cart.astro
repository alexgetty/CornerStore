---
import "./Cart.css";
import "../Listings/ListingTable.css";
import ListingRow from "../Listings/ListingRow.astro";
import ListingThead from "../Listings/ListingThead.astro";
import type { Listing } from "../../lib/storefront";

interface Props {
  storeName: string;
  contact: string;
  listings: Listing[];
  currency: string;
  minCartSizeRaw: number | null;
  wholesaleMargin?: number;
  checkoutEnabled: boolean;
  shippingFlat?: number;
  shippingFreeThreshold?: number;
  checkoutUrl?: string;
}

const {
  storeName,
  contact,
  listings,
  currency,
  minCartSizeRaw,
  wholesaleMargin,
  checkoutEnabled,
  shippingFlat,
  shippingFreeThreshold,
  checkoutUrl,
} = Astro.props;

const hasWholesale = wholesaleMargin != null;

const priceMap: Record<string, number> = {};
const disabledSkus: string[] = [];
for (const listing of listings) {
  priceMap[listing.sku] = hasWholesale
    ? Math.round(listing.rawPrice * wholesaleMargin!)
    : listing.rawPrice;
  if (listing.status != null) disabledSkus.push(listing.sku);
}
---

<div
  class="cs-cart"
  data-currency={currency}
  data-min-cart-size-raw={minCartSizeRaw ?? ''}
  data-contact={contact}
  data-store-name={storeName}
  data-checkout-enabled={checkoutEnabled ? 'true' : ''}
  data-shipping-flat={shippingFlat ?? ''}
  data-shipping-free-threshold={shippingFreeThreshold ?? ''}
  data-checkout-url={checkoutUrl ?? ''}
  data-prices={JSON.stringify(priceMap)}
  data-disabled-skus={JSON.stringify(disabledSkus)}
>
  <p class="cs-cart-empty">Your cart is empty. <a href="/">Continue shopping</a></p>

  <div class="cs-cart-content" hidden>
    <div class="cs-cart-unavailable-banner" hidden role="alert">
      <button type="button" class="cs-clear-unavailable">Remove unavailable items</button>
    </div>
    <table class="cs-listing-table" role="table">
      <ListingThead hasWholesale={hasWholesale} />
      <tbody role="rowgroup">
        {listings.map((listing) => (
          <ListingRow
            listing={listing}
            currency={currency}
            hasWholesale={hasWholesale}
            wholesaleMargin={wholesaleMargin}
          />
        ))}
      </tbody>
      <tfoot>
        <tr class="cs-totals-row">
          <th colspan={3} scope="row" class="cs-totals-label">Subtotal</th>
          <td class="cs-col-total">
            <span class="cs-subtotal-value cs-totals-value">$0.00</span>
          </td>
          <td class="cs-col-controls"></td>
        </tr>
      </tfoot>
    </table>

    <div class="cs-cart-summary" hidden>
      <p class="cs-shipping-status"></p>
    </div>

    <div class="cs-cart-errors" hidden></div>
    <div class="cs-unavailable-notice" hidden></div>

    {!checkoutEnabled && (
      <p class="cs-pdf-notice">Clicking will download a PDF order form — you'll need to email it to us to complete your order.</p>
    )}

    <div class="cs-cart-actions">
      <div class="cs-cart-actions-secondary">
        <button type="button" class="cs-clear-cart">Clear all</button>
        <span class="cs-clear-cart-confirm" hidden role="group" aria-label="Confirm clear cart">
          <span class="cs-clear-cart-prompt">Clear entire cart?</span>
          <button type="button" class="cs-clear-cart-yes">Yes, clear</button>
          <button type="button" class="cs-clear-cart-cancel">Cancel</button>
        </span>
      </div>
      <button type="button" class="cs-submit-btn" disabled>
        {checkoutEnabled ? 'Checkout' : 'Download Order Form'}
      </button>
    </div>

    <div class="cs-checkout-error" hidden></div>
    <div class="cs-checkout-fallback" hidden>
      <button type="button" class="cs-retry-btn">Try Again</button>
      <button type="button" class="cs-pdf-btn">Download PDF</button>
    </div>

    <div class="cs-mailto-section" hidden>
      <p>Your order form has downloaded, but <strong>we haven't received it yet</strong> — email it to us to complete your order. We're a simple static site with no checkout backend, so this is how orders reach us.</p>
      <a class="cs-mailto-link" href="#">Email your order form</a>
      <p>Your cart is unchanged. Use <em>Clear all</em> once you've sent the email, or update your cart and re-download if you need to make changes first.</p>
    </div>
  </div>
</div>

<script>
  import './cart.ts';
</script>
