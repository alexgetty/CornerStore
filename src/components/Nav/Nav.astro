---
import "./Nav.css";
import CartWidget from "../CartWidget/CartWidget.astro";
import type { ResolvedNavItem } from "../../lib/storefront";

interface Props {
  storeName: string;
  logo?: string;
  nav: ResolvedNavItem[];
  currentPath?: string;
  priceMap?: Record<string, number>;
  disabledSkus?: string[];
  currency?: string;
}

const { storeName, logo, nav, currentPath, priceMap, disabledSkus, currency } = Astro.props;

function normalizePath(p: string): string {
  return p === '/' ? p : p.replace(/\/$/, '');
}

const normalizedCurrentPath = currentPath ? normalizePath(currentPath) : undefined;
---

<header class="cs-header">
  <a href="/" class="cs-store-name">
    {logo && <img src={logo} alt="" class="cs-logo" />}
    {storeName}
  </a>
  <div class="cs-header-actions">
    {nav.length > 0 && (
      <details class="cs-nav-drawer">
        <summary class="cs-nav-toggle" aria-label="Menu">
          <span class="cs-nav-toggle-icon" aria-hidden="true"></span>
        </summary>
        <nav aria-label="Main">
          <ul class="cs-nav-links">
            {nav.map((item) => (
              item.children ? (
                item.href ? (
                  <li class="cs-nav-dropdown cs-nav-dropdown-combo">
                    <details name="cs-nav-accordion">
                      <a
                        href={item.href}
                        class="cs-nav-dropdown-link"
                        {...(normalizedCurrentPath === normalizePath(item.href) ? { "aria-current": "page" as const } : {})}
                      >
                        {item.label}
                      </a>
                      <summary class="cs-nav-chevron" aria-label={`Toggle ${item.label} submenu`}></summary>
                      <ul class="cs-nav-dropdown-menu">
                        {item.children.map((child) => (
                          <li>
                            <a
                              href={child.href}
                              {...(normalizedCurrentPath === normalizePath(child.href ?? '') ? { "aria-current": "page" as const } : {})}
                            >
                              {child.label}
                            </a>
                          </li>
                        ))}
                      </ul>
                    </details>
                  </li>
                ) : (
                  <li class="cs-nav-dropdown">
                    <details name="cs-nav-accordion">
                      <summary class="cs-nav-dropdown-trigger">{item.label}</summary>
                      <ul class="cs-nav-dropdown-menu">
                        {item.children.map((child) => (
                          <li>
                            <a
                              href={child.href}
                              {...(normalizedCurrentPath === normalizePath(child.href ?? '') ? { "aria-current": "page" as const } : {})}
                            >
                              {child.label}
                            </a>
                          </li>
                        ))}
                      </ul>
                    </details>
                  </li>
                )
              ) : (
                <li>
                  <a
                    href={item.href}
                    {...(normalizedCurrentPath === normalizePath(item.href ?? '') ? { "aria-current": "page" as const } : {})}
                  >
                    {item.label}
                  </a>
                </li>
              )
            ))}
          </ul>
        </nav>
      </details>
    )}
    {priceMap && currency && (
      <CartWidget priceMap={priceMap} disabledSkus={disabledSkus} currency={currency} />
    )}
  </div>
</header>
