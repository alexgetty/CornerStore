---
import "./Nav.css";
import CartWidget from "../CartWidget/CartWidget.astro";
import type { ResolvedNavItem } from "../../lib/storefront";

interface Props {
  storeName: string;
  logo?: string;
  nav: ResolvedNavItem[];
  currentPath?: string;
  priceMap?: Record<string, number>;
  disabledSkus?: string[];
  currency?: string;
}

const { storeName, logo, nav, currentPath, priceMap, disabledSkus, currency } = Astro.props;

function normalizePath(p: string): string {
  return p === '/' ? p : p.replace(/\/$/, '');
}

const normalizedCurrentPath = currentPath ? normalizePath(currentPath) : undefined;
---

<header class="cs-header">
  <a href="/" class="cs-store-name">
    {logo && <img src={logo} alt="" class="cs-logo" />}
    {storeName}
  </a>
  <div class="cs-header-actions">
    {nav.length > 0 && (
      <>
        <button
          type="button"
          class="cs-nav-toggle"
          aria-expanded="false"
          aria-controls="cs-nav-main"
          aria-label="Menu"
        >
          <span class="cs-nav-toggle-icon" aria-hidden="true"></span>
        </button>
        <nav id="cs-nav-main" class="cs-nav-drawer" aria-label="Main">
          <ul class="cs-nav-links">
            {nav.map((item) => (
              item.children ? (
                item.href ? (
                  <li class="cs-nav-dropdown cs-nav-dropdown-combo">
                    <a
                      href={item.href}
                      class="cs-nav-dropdown-link"
                      {...(normalizedCurrentPath === normalizePath(item.href) ? { "aria-current": "page" as const } : {})}
                    >
                      {item.label}
                    </a>
                    <button
                      type="button"
                      class="cs-nav-chevron"
                      aria-expanded="false"
                      aria-label={`Toggle ${item.label} submenu`}
                    ></button>
                    <ul class="cs-nav-dropdown-menu">
                      {item.children.map((child) => (
                        <li>
                          <a
                            href={child.href}
                            {...(normalizedCurrentPath === normalizePath(child.href ?? '') ? { "aria-current": "page" as const } : {})}
                          >
                            {child.label}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </li>
                ) : (
                  <li class="cs-nav-dropdown">
                    <button
                      type="button"
                      class="cs-nav-dropdown-trigger"
                      aria-expanded="false"
                    >
                      {item.label}
                    </button>
                    <ul class="cs-nav-dropdown-menu">
                      {item.children.map((child) => (
                        <li>
                          <a
                            href={child.href}
                            {...(normalizedCurrentPath === normalizePath(child.href ?? '') ? { "aria-current": "page" as const } : {})}
                          >
                            {child.label}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </li>
                )
              ) : (
                <li>
                  <a
                    href={item.href}
                    {...(normalizedCurrentPath === normalizePath(item.href ?? '') ? { "aria-current": "page" as const } : {})}
                  >
                    {item.label}
                  </a>
                </li>
              )
            ))}
          </ul>
        </nav>
      </>
    )}
    {priceMap && currency && (
      <CartWidget priceMap={priceMap} disabledSkus={disabledSkus} currency={currency} />
    )}
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.cs-nav-toggle');
  const drawer = document.querySelector<HTMLElement>('.cs-nav-drawer');
  const dropdowns = document.querySelectorAll<HTMLButtonElement>(
    '.cs-nav-dropdown-trigger, .cs-nav-chevron',
  );

  function setExpanded(btn: HTMLButtonElement, value: boolean) {
    btn.setAttribute('aria-expanded', value ? 'true' : 'false');
  }

  function isExpanded(btn: HTMLButtonElement) {
    return btn.getAttribute('aria-expanded') === 'true';
  }

  if (toggle && drawer) {
    toggle.addEventListener('click', () => {
      const next = !isExpanded(toggle);
      setExpanded(toggle, next);
      if (next) drawer.scrollIntoView({ block: 'nearest' });
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isExpanded(toggle)) setExpanded(toggle, false);
    });

    document.addEventListener('pointerdown', (e) => {
      if (!isExpanded(toggle)) return;
      const target = e.target as Node;
      if (toggle.contains(target) || drawer.contains(target)) return;
      setExpanded(toggle, false);
    });
  }

  dropdowns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const next = !isExpanded(btn);
      dropdowns.forEach((other) => {
        if (other !== btn) setExpanded(other, false);
      });
      setExpanded(btn, next);
    });
  });
</script>
