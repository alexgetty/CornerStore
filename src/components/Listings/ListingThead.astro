---
interface Props {
  hasWholesale: boolean;
  productLabel?: string | null;
}

const { hasWholesale, productLabel = null } = Astro.props;
---

<thead role="rowgroup">
  <tr role="row">
    <th class="cs-col-image" scope="col" role="columnheader"><span class="cs-sr-only">Image</span></th>
    <th class="cs-col-product" scope="col" role="columnheader">
      {productLabel ? productLabel : <span class="cs-sr-only">Product</span>}
    </th>
    <th class="cs-col-price" scope="col" role="columnheader">{hasWholesale ? 'Wholesale' : 'Unit Price'}</th>
    <th class="cs-col-total" scope="col" role="columnheader">Line Total</th>
    <th class="cs-col-controls" scope="col" role="columnheader"></th>
  </tr>
</thead>
