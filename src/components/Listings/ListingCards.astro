---
import "./ListingCards.css";
import "../Lightbox/Lightbox.css";
import CartControl from "../CartControl/CartControl.astro";
import type { Listing } from "../../lib/storefront";
import { rawPriceToDecimal, formatPrice } from "../../lib/storefront";

interface Props {
  listings: Listing[];
  currency?: string;
  wholesaleMargin?: number;
}

const { listings, currency = 'usd', wholesaleMargin } = Astro.props;
const isWholesale = wholesaleMargin != null;
---

<section class="cs-listing-cards" aria-label="Products">
  {listings.length > 0 ? (
    <ul role="list">
      {listings.map((listing) => {
        const effectiveRaw = isWholesale
          ? Math.round(listing.rawPrice * wholesaleMargin!)
          : listing.rawPrice;
        const effectiveCurrency = isWholesale ? currency : listing.currency;
        const effectivePrice = isWholesale
          ? formatPrice(effectiveRaw, currency)
          : listing.price;
        return (
        <li>
          <article
            class="cs-listing"
            itemscope
            itemtype="https://schema.org/Product"
            data-sku={listing.sku}
            data-raw-price={effectiveRaw}
            data-moq={listing.moq ?? ''}
            data-currency={listing.currency}
            data-status={listing.status ?? ''}
          >
            <figure class="cs-listing-image">
              {
                listing.images.length > 0 ? (
                  <button
                    type="button"
                    class="cs-listing-image-btn"
                    aria-haspopup="dialog"
                    data-images={JSON.stringify(listing.images)}
                  >
                    <img src={listing.images[0].url} alt={listing.images[0].alt} itemprop="image" />
                  </button>
                ) : (
                  <div class="cs-listing-placeholder" aria-label={`${listing.name} product image`} />
                )
              }
            </figure>

            <span class="cs-listing-badge" hidden></span>

            <div class="cs-listing-details">
              {listing.category && <span class="cs-listing-category">{listing.category}</span>}
              <h2 class="cs-listing-name" itemprop="name">{listing.name}</h2>
              {listing.description && <p class="cs-listing-description" itemprop="description">{listing.description}</p>}
              <p class="cs-listing-price" itemprop="offers" itemscope itemtype="https://schema.org/Offer">
                <data
                  value={String(rawPriceToDecimal(effectiveRaw, effectiveCurrency))}
                  itemprop="price"
                  aria-label={"Price: " + effectivePrice}
                >{effectivePrice}</data>
                <meta itemprop="priceCurrency" content={effectiveCurrency.toUpperCase()} />
              </p>
              {listing.moq && <span class="cs-listing-moq">Min {listing.moq}</span>}
            </div>

            <div class="cs-listing-cart">
              <CartControl
                sku={listing.sku}
                name={listing.name}
                moq={listing.moq}
                status={listing.status}
              />
            </div>
          </article>
        </li>
        );
      })}
    </ul>
  ) : (
    <p class="cs-listings-empty">No products available.</p>
  )}
</section>

<script>
  import "../Lightbox/lightbox.ts";
</script>
