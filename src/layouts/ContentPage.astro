---
import Base from "./Base.astro";
import Nav from "../components/Nav/Nav.astro";
import "./ContentPage.css";
import { loadConfig, loadPages, getNav, getListings, getCategories, loadCategoryPages, DEFAULT_CURRENCY } from "../lib/storefront";
import type { ResolvedNavItem } from "../lib/storefront";

interface Props {
  title: string;
  hasExplicitTitle?: boolean;
  description?: string;
}

const { title, hasExplicitTitle = true, description: descriptionProp } = Astro.props;
const config = await loadConfig();
const pages = await loadPages(config);
const categories = await getCategories();
const categoryPages = await loadCategoryPages();
const { nav, footerNav } = getNav(config, pages, {
  catalogCategories: categories,
  customCategoryPages: categoryPages,
});

const segments = Astro.url.pathname.split('/').filter(Boolean);
let derivedDescription: string | undefined;
if (segments.length === 0) {
  derivedDescription = pages.get(config.home)?.description;
} else if (segments[0] === 'category' && segments[1]) {
  derivedDescription = categoryPages.get(segments[1])?.description;
} else if (segments.length === 1) {
  derivedDescription = pages.get(segments[0])?.description;
}
const description = descriptionProp ?? derivedDescription;

const listings = await getListings();
const priceMap: Record<string, number> = {};
const disabledSkus: string[] = [];
for (const listing of listings) {
  priceMap[listing.sku] = config.wholesaleMargin != null
    ? Math.round(listing.rawPrice * config.wholesaleMargin)
    : listing.rawPrice;
  if (listing.status != null) disabledSkus.push(listing.sku);
}
---

<Base title={`${title} — ${config.name}`} description={description}>
  <Nav slot="header" storeName={config.name} logo={config.logo} nav={nav} currentPath={Astro.url.pathname} priceMap={priceMap} disabledSkus={disabledSkus} currency={DEFAULT_CURRENCY} />
  <main id="main-content">
    <h1 class:list={[{ 'cs-sr-only': !hasExplicitTitle }]}>{title}</h1>
    {description && <p class="cs-page-description">{description}</p>}
    <slot />
  </main>
  {(footerNav.length > 0 || config.contact) && (
    <footer class="cs-footer">
      {footerNav.length > 0 && (
        <nav aria-label="Footer">
          <ul class="cs-footer-links">
            {footerNav.map((item: ResolvedNavItem) => (
              <li>{item.href ? <a href={item.href}>{item.label}</a> : item.label}</li>
            ))}
          </ul>
        </nav>
      )}
      {config.contact && (
        <p class="cs-footer-contact">
          <a href={`mailto:${config.contact}`}>{config.contact}</a>
        </p>
      )}
    </footer>
  )}
</Base>
