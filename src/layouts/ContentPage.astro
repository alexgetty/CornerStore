---
import Base from "./Base.astro";
import Nav from "../components/Nav/Nav.astro";
import "./ContentPage.css";
import { loadConfig, getNav } from "../lib/storefront";
import type { ResolvedNavItem } from "../lib/storefront";

interface Props {
  title: string;
  hasExplicitTitle?: boolean;
  description?: string;
}

const { title, hasExplicitTitle = true, description } = Astro.props;
const config = await loadConfig();
const { nav, footerNav } = getNav(config);
---

<Base title={`${title} — ${config.name}`} description={description}>
  <Nav storeName={config.name} nav={nav} currentPath={Astro.url.pathname} />
  <main id="main-content">
    <h1 class:list={[{ 'cs-sr-only': !hasExplicitTitle }]}>{title}</h1>
    <slot />
  </main>
  {(footerNav.length > 0 || config.contact) && (
    <footer class="cs-footer">
      {footerNav.length > 0 && (
        <nav aria-label="Footer">
          <ul class="cs-footer-links">
            {footerNav.map((item: ResolvedNavItem) => (
              <li><a href={item.href}>{item.label}</a></li>
            ))}
          </ul>
        </nav>
      )}
      {config.contact && (
        <p class="cs-footer-contact">
          <a href={`mailto:${config.contact}`}>{config.contact}</a>
        </p>
      )}
    </footer>
  )}
</Base>
