{
  "name": "corner-store",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "corner-store": "./bin/init.mjs",
    "corner-store-catalog": "./bin/catalog.mjs"
  },
  "exports": {
    ".": "./src/lib/storefront/index.ts",
    "./stripe": "./src/lib/stripe/index.ts",
    "./catalog": "./src/lib/catalog/index.ts",
    "./components": "./src/components/index.ts",
    "./layouts/Base": "./src/layouts/Base.astro",
    "./layouts/ContentPage": "./src/layouts/ContentPage.astro",
    "./styles/reset.css": "./src/styles/reset.css",
    "./styles/palette.css": "./src/styles/palette.css",
    "./styles/defaults.css": "./src/styles/defaults.css"
  },
  "files": [
    "bin/",
    "src/lib/",
    "src/components/",
    "src/layouts/",
    "src/styles/"
  ],
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "ci": "npm run typecheck && npm run test:coverage && npm run build",
    "catalog": "tsx bin/catalog.ts",
    "catalog:diff": "tsx bin/catalog.ts diff",
    "catalog:add": "tsx bin/catalog.ts add",
    "catalog:update": "tsx bin/catalog.ts update",
    "catalog:sync": "tsx bin/catalog.ts sync",
    "build:cli": "esbuild bin/catalog.ts --bundle --format=esm --platform=node --target=node18 --outfile=bin/catalog.mjs --packages=external --banner:js='#!/usr/bin/env node'",
    "prepublishOnly": "npm run build:cli"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.3.14",
    "csv-parse": "^6.2.1",
    "csv-stringify": "^6.7.0",
    "html2pdf.js": "^0.14.0",
    "js-yaml": "^4.1.1",
    "stripe": "^20",
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "astro": "^5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.4.0",
    "@vitest/coverage-v8": "^2",
    "esbuild": "^0.28.0",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^2"
  }
}
